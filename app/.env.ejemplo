# Copia este archivo como app/.env y completa tus valores. NUNCA subas el .env real.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Identificador del corpus y revisión de los embeddings: están en el JSON de evidencia de la Clase 9
# (campos "corpus_id" y "configuracion_embeddings.revision").
CORPUS_ID=
EMBEDDINGS_REVISION=
# Vacío = el servidor MCP propio (servidor_mcp.py) se lanza como subproceso por stdio.
# Para un MCP remoto: URL de su endpoint streamable-http (p. ej. https://mi-mcp.onrender.com/mcp)
MCP_URL=
GRADIO_SERVER_NAME=127.0.0.1
PORT=7860
